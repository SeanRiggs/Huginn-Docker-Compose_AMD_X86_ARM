# Copy/reference only: generate .env with python3 scripts/setup.py.
# Keep these images pinned to a tested Huginn release and MySQL LTS series.
HUGINN_IMAGE=ghcr.io/huginn/huginn:v2026.10.24
MYSQL_IMAGE=mysql:8.4
HUGINN_BIND_ADDRESS=127.0.0.1
HUGINN_PORT=3000
DOMAIN=localhost:3000
FORCE_SSL=false
TIMEZONE=UTC
MYSQL_DATABASE=huginn_production
MYSQL_USER=huginn
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
APP_SECRET_TOKEN=
SEED_USERNAME=admin
SEED_EMAIL=admin@example.invalid
SEED_PASSWORD=
INVITATION_CODE=
# Enable for instances where untrusted users can create agents; see README.
ENABLE_SMOKESCREEN=false
